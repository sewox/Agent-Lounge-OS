# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Tauri / Rust
src-tauri/target
src-tauri/gen
shared/lounge_protocol/target
shared/lounge_protocol/Cargo.lock

# Native binaries (resolved at runtime from PATH if missing)
bridge/codebase-memory-mcp
bridge/codebase-memory-mcp.exe

# LMR (Lounge Model Runner) — uygulama içi runtime + model deposu
data/lmr/
data/ollama/
data/nats/

# Local experience store
experiences/*.sqlite
experiences/*.sqlite-journal
