{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-lounge-os.local/schemas/mcp_yield_result.schema.json",
  "title": "McpYieldResultArgs",
  "description": "lounge_yield_result — yalnız target_agent bağlı (veya claim sahibi) oturum. metrics bilgilendirme amaçlı. output serileştirilmiş boyutu pratikte 256KiB ile sınırlıdır.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "status", "output"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": {
      "type": "string",
      "enum": ["completed", "failed"]
    },
    "output": {},
    "artifacts": {
      "type": "array",
      "maxItems": 64,
      "items": {}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
