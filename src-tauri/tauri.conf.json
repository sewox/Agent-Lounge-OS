{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Agent Lounge OS",
  "version": "0.1.0",
  "identifier": "com.agentlounge.os",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "bash src-tauri/scripts/prepare-sidecar.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Agent Lounge OS",
        "minWidth": 960,
        "minHeight": 640,
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Agent Lounge",
    "copyright": "Copyright © Agent Lounge",
    "category": "DeveloperTool",
    "shortDescription": "Yerel ajan orkestrasyon katmanı",
    "longDescription": "Agent Lounge OS — Lounge Kernel üzerinde yerel ajan orkestrasyonu, bellek köprüsü ve model çalışma zamanı.",
    "homepage": "https://github.com/sewox/Agent-Lounge-OS",
    "externalBin": ["binaries/codebase-memory-mcp"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Agent Lounge OS"
      }
    }
  }
}
