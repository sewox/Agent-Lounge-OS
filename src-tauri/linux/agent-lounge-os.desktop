# tauri.conf.json → bundle.linux.deb.desktopTemplate points here.
# An rpm target would need its own bundle.linux.rpm.desktopTemplate setting.
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %u
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}};
{{/if}}
